{
    "name": "react-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "node ./commands/delete-build-folder.js && react-scripts build",
        "start": "serve -s build -l 3000",
        "start:typescript": "react-scripts start",
        "test": "react-scripts test",
        "eject": "react-scripts eject",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "check": "npm run build && npm run lint && npm run test"
    },
    "dependencies": {
        "@simplisticated/easy-storage": "2.1.10",
        "@testing-library/jest-dom": "5.11.4",
        "@testing-library/react": "11.1.0",
        "@testing-library/user-event": "12.1.10",
        "@types/mixpanel-browser": "2.51.0",
        "axios": "0.24.0",
        "es5-ext": "0.10.53",
        "mixpanel-browser": "2.59.0",
        "mobx": "6.3.9",
        "mobx-react": "7.2.1",
        "react": "17.0.1",
        "react-dom": "17.0.1",
        "react-router-dom": "5.3.0",
        "react-scripts": "5.0.0",
        "uuid": "8.3.2",
        "web-vitals": "1.0.1"
    },
    "devDependencies": {
        "@types/jest": "26.0.15",
        "@types/node": "12.0.0",
        "@types/react": "17.0.0",
        "@types/react-dom": "17.0.0",
        "@types/react-router-dom": "5.3.1",
        "@types/uuid": "10.0.0",
        "@typescript-eslint/eslint-plugin": "5.12.0",
        "@typescript-eslint/parser": "5.12.0",
        "eslint": "8.7.0",
        "eslint-config-airbnb": "19.0.4",
        "eslint-config-airbnb-base": "15.0.0",
        "eslint-config-airbnb-typescript": "16.1.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-import": "2.25.4",
        "eslint-plugin-jsx-a11y": "6.5.1",
        "eslint-plugin-react": "7.29.4",
        "eslint-plugin-react-hooks": "4.3.0",
        "prettier": "3.1.0",
        "serve": "13.0.2",
        "typescript": "4.1.2"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "engines": {
        "node": ">=20"
    }
}
