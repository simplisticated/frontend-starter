{
    "name": "frontend-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "node ./package_scripts/delete-build-folder.js && react-scripts build",
        "start": "serve -s build -l 3000",
        "start:dev": "react-scripts start",
        "format": "prettier --write ."
    },
    "dependencies": {
        "react": "17.0.1",
        "react-dom": "17.0.1",
        "react-helmet": "6.1.0",
        "react-router-dom": "5.3.0",
        "react-scripts": "5.0.0",
        "uuid": "8.3.2",
        "web-vitals": "1.0.1"
    },
    "overrides": {
        "es5-ext": "0.10.53"
    },
    "devDependencies": {
        "@types/node": "12.0.0",
        "@types/react": "17.0.0",
        "@types/react-dom": "17.0.0",
        "@types/react-helmet": "6.1.11",
        "@types/react-router-dom": "5.3.1",
        "@types/uuid": "10.0.0",
        "prettier": "2.5.1",
        "serve": "13.0.2",
        "typescript": "6.0.3"
    },
    "browserslist": {
        "production": [
            ">0.2%"
        ],
        "development": [
            "last 1 chrome version"
        ]
    },
    "engines": {
        "node": ">=24"
    }
}
